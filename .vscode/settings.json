{
    // --- LaTeX Workshop: thesis build pipeline ---
    // Use the repo's latexmkrc (lualatex + biber + out_dir=build) as the single source of truth.
    // One recipe for both roots: the rc file decides engine and out_dir, and the
    // root file is passed through as %DOC%.
    //
    // The command is .vscode/build.sh rather than latexmk itself: it runs the
    // same latexmk call, then rebuilds slides-notes.tex whenever the root was
    // the deck. slides-notes.tex \inputs slides.tex, so it is a second root that
    // root detection can never reach -- see the comment at the top of build.sh.
    "latex-workshop.latex.recipe.default": "latexmk (thesis)",
    "latex-workshop.latex.recipes": [
        {
            "name": "latexmk (thesis)",
            "tools": ["latexmk-thesis"]
        }
    ],
    "latex-workshop.latex.tools": [
        {
            "name": "latexmk-thesis",
            // Run through `sh` on purpose: LaTeX Workshop expands %WORKSPACE_FOLDER%
            // in `args` but NOT in `command`, so naming the script directly there
            // spawns the literal placeholder and fails with ENOENT.
            "command": "sh",
            "args": [
                "%WORKSPACE_FOLDER%/.vscode/build.sh",
                "%DOC%"
            ],
            "env": {}
        }
    ],

    // Pin the root files so building from a chapter/section file still targets
    // thesis.tex, and building from anything under slides/ targets the deck.
    "latex-workshop.latex.rootFile.doNotPrompt": true,
    "latex-workshop.latex.rootFile.useSubFile": false,
    "latex-workshop.latex.rootFile.indicator": "\\begin{document}",
    "latex-workshop.latex.search.rootFiles.include": ["thesis.tex", "slides/slides.tex"],

    // Magic comments must stay on: slides/slides-notes.tex has no
    // \begin{document} of its own (it only \inputs the deck), so the indicator
    // scan above can never see it as a root. It pins itself with a
    // self-referential `% !TeX root', which findFromMagic() honours before any
    // content scan -- that is what makes build/view/SyncTeX from that tab
    // target the notes deck instead of falling through to slides.tex.
    // Deliberately NOT added to rootFiles.include: root detection would then
    // also match it by .fls children and could hijack slides.tex's own root.
    "latex-workshop.latex.build.enableMagicComments": true,

    // Every input path in this repo (figures, \include, \subimport) is resolved
    // relative to the repo root, so builds must run from there. Without this,
    // LaTeX Workshop uses the root file's own directory, which breaks the deck:
    // slides/slides.tex pulls figures from chapters/ and papers/.
    "latex-workshop.latex.build.fromFolder": ".",

    // PDFs live in build/ (per latexmkrc $out_dir): build/thesis.pdf,
    // build/slides.pdf, build/slides-notes.pdf. Absolute, because LaTeX
    // Workshop resolves a relative outDir against the root file's directory --
    // a bare "build" would send it looking for slides/build/slides.pdf, and
    // SyncTeX would find nothing.
    // This is a single global setting with no per-root override, which is why
    // the notes deck is built into build/ rather than build/notes: anywhere
    // else and the viewer could not find its PDF.
    "latex-workshop.latex.outDir": "%WORKSPACE_FOLDER%/build",

    // Build on save; debounce a bit so rapid saves don't queue multiple runs.
    "latex-workshop.latex.autoBuild.run": "onSave",
    "latex-workshop.latex.autoBuild.interval": 1000,

    // Internal tab viewer — auto-reloads on rebuild, supports SyncTeX out of the box.
    "latex-workshop.view.pdf.viewer": "tab",
    "latex-workshop.view.pdf.invertMode.enabled": "auto",

    // Forward search: jump from .tex (cursor) to PDF (Ctrl/Cmd+Alt+J).
    "latex-workshop.synctex.afterBuild.enabled": true,
    // Inverse search (PDF → .tex): in the internal viewer, Ctrl/Cmd+click on the PDF.

    // Keep aux noise out of the explorer — they live in build/ anyway, but the root
    // also accrues a few when chapter files are compiled standalone.
    "latex-workshop.latex.autoClean.run": "never",
    "latex-workshop.message.update.show": false,

    // Always compile through the recipe above, even though magic comments are
    // enabled: `% !TeX root' should steer root detection, but a stray
    // `% !TeX program' must never bypass .vscode/build.sh.
    "latex-workshop.latex.build.forceRecipeUsage": true,

    // --- Grammar / spell check: strict American English everywhere ---
    // Both extensions wrap the same LanguageTool engine. Division of labor:
    // LTeX owns LaTeX (.tex/.bib), adamvoss.vscode-languagetool owns markdown/plaintext.

    // LTeX -> American English. en-US flags British spellings (e.g. "initialisation"
    // -> "initialization") via LanguageTool's en-US dictionary.
    "ltex.language": "en-US",
    // Default ltex.enabled list MINUS "markdown" so LTeX doesn't double-check markdown
    // (left to adamvoss below). Everything else here is the LTeX default.
    "ltex.enabled": [
        "bibtex", "context", "context.tex", "html", "latex", "org",
        "restructuredtext", "rsweave"
    ],
    // Custom domain terms so LTeX doesn't flag them as misspellings.
    "ltex.dictionary": {
        "en-US": [
            "ansatz", "covariates", "Extragradient", "Gaussianity", "Lipschitz",
            "overparametrized", "overparametrizing", "Stochasticity", "subgaussian",
            "subleading"
        ]
    },

    // adamvoss.vscode-languagetool stays active for markdown/plaintext (its only
    // activation events), pinned to American English -- its default is the generic "en".
    "languageTool.language": "en-US",

    // cSpell stays disabled in this workspace -- LTeX handles spelling.
    "cSpell.enabled": false
}
